# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CLICKSTREAM=clickstream-events
KAFKA_TOPIC_TRANSACTION=transaction-events
KAFKA_TOPIC_PRODUCT=product-events
KAFKA_TOPIC_INVENTORY=inventory-events
KAFKA_TOPIC_INVALID=invalid-events
KAFKA_TOPIC_DLQ=dead-letter-events

# Replay
REPLAY_SPEED_MULTIPLIER=10
REPLAY_BATCH_SIZE=1000
REPLAY_DELAY_MS=100

# Spark
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_PATH=./checkpoints
WATERMARK_DELAY=10 minutes

# Storage
DATA_LAKE_PATH=./data/processed
BRONZE_PATH=./data/processed/bronze
SILVER_PATH=./data/processed/silver
GOLD_PATH=./data/processed/gold

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novacart
POSTGRES_USER=novacart
POSTGRES_PASSWORD=changeme

# Synthetic
SYNTHETIC_SEED=42
SYNTHETIC_RATE_PER_SEC=5